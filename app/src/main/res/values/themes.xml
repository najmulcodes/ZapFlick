<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZapFlick" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- ViewerActivity: same look as the app, its own style so it can diverge (for example for WebView). -->
    <style name="Theme.ZapFlick.Viewer" parent="Theme.ZapFlick">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
